FROM factorynav-ai:jazzy
RUN python3 -m venv --system-site-packages /opt/factorynav-perception \
    && /opt/factorynav-perception/bin/pip install --no-cache-dir \
       --index-url https://download.pytorch.org/whl/cpu \
       torch==2.14.1+cpu torchvision==0.29.1+cpu
COPY .cache/wheels/ /tmp/factorynav-wheels/
RUN /opt/factorynav-perception/bin/pip install --no-cache-dir --no-index --find-links=/tmp/factorynav-wheels \
       ultralytics==8.4.191 numpy==1.26.4 opencv-python==4.11.0.86 tzdata==2026.5 \
    && /opt/factorynav-perception/bin/pip check
ENV YOLO_CONFIG_DIR=/workspace/.cache/ultralytics
