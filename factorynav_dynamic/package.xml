<?xml version="1.0"?>
<package format="3">
  <name>factorynav_dynamic</name><version>0.2.0</version>
  <description>Independent factory traffic and measured Nav2 experiments.</description>
  <maintainer email="codex@openai.com">FactoryNav AI contributors</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend><exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
